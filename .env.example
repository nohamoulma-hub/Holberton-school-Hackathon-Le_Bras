# Clé API Anthropic (jamais commitée, uniquement dans .env)
ANTHROPIC_API_KEY=

# Effort du modèle (low | medium | high | xhigh | max). Compromis vitesse/qualité pour la
# sélection d'outil et la rédaction. medium par défaut, monter à high en cas de mauvais choix
# d'outil, descendre à low pour la démo si la latence gêne.
AGENT_EFFORT=medium

# Liste d'outils à désactiver, séparés par des virgules (ex: create_issue,send_message).
# Utile pour démontrer en direct que l'app ne plante pas quand un outil est débranché :
# éditer cette ligne, sauvegarder, relancer la même requête (rechargée à chaque appel,
# pas besoin de redémarrer le serveur). Vide par défaut = tous les outils actifs.
DISABLED_TOOLS=