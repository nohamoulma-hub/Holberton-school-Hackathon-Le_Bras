# Clé API Anthropic (jamais commitée, uniquement dans .env)
ANTHROPIC_API_KEY=

# Effort du modèle (low | medium | high | xhigh | max). Compromis vitesse/qualité pour la
# sélection d'outil et la rédaction. medium par défaut, monter à high en cas de mauvais choix
# d'outil, descendre à low pour la démo si la latence gêne.
AGENT_EFFORT=medium

# Outils désactivés au démarrage du serveur, séparés par des virgules (ex: create_issue).
# Après démarrage, activer/désactiver un outil se fait depuis le panneau "Outils actifs"
# du front (ou via POST /tools/{nom}/toggle), sans redémarrer le serveur. Vide par défaut.
DISABLED_TOOLS=