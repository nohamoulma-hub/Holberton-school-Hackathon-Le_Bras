# Clé API Anthropic (jamais commitée, uniquement dans .env)
ANTHROPIC_API_KEY=

# Effort du modèle (low | medium | high | xhigh | max). Compromis vitesse/qualité pour la
# sélection d'outil et la rédaction. medium par défaut, monter à high en cas de mauvais choix
# d'outil, descendre à low pour la démo si la latence gêne.
AGENT_EFFORT=medium

# Fuseau utilisé pour résoudre aujourd'hui, demain, lundi et les autres dates relatives.
APP_TIMEZONE=Europe/Paris

# Outils désactivés au démarrage du serveur, séparés par des virgules (ex: create_issue).
# Après démarrage, activer/désactiver un outil se fait depuis le panneau "Outils actifs"
# du front (ou via POST /tools/{nom}/toggle), sans redémarrer le serveur. Vide par défaut.
DISABLED_TOOLS=

# Passer à true uniquement derrière HTTPS en production.
SESSION_COOKIE_SECURE=false

# PostgreSQL local lancé par Docker Compose. Remplacez ces exemples en production.
POSTGRES_DB=lebras
POSTGRES_USER=lebras
POSTGRES_PASSWORD=lebras_local_password

# Utilisée par FastAPI. Dans Docker Compose, l'hôte PostgreSQL est le service `db`.
DATABASE_URL=postgresql://lebras:lebras_local_password@db:5432/lebras
